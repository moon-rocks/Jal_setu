# Supabase Project Configuration
# Replace with your Supabase Project URL & Anon/Public API Key
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Server-only credentials. Never prefix these with VITE_ or expose them to browser code.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Set this in Supabase Edge Function secrets, not in the browser environment.
# GEMINI_API_KEY=your-gemini-api-key
