VITE_SUPABASE_URL=https://your-project-id.supabase.co
# Public frontend build variables (safe to expose to the browser).
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

VITE_API_BASE_URL=http://localhost:3000

# Server-only API values. Never prefix these with VITE_ or expose them to browser code.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Configure this in Supabase Edge Function secrets, not in Vercel frontend variables.
# GEMINI_API_KEY=your-gemini-api-key
