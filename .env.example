# Vercel frontend build variables (public values used by the Vite client)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Server-only values. Never prefix these with VITE_ or expose them to browser code.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Configure this in Supabase Edge Function secrets, not in Vercel frontend variables.
# GEMINI_API_KEY=your-gemini-api-key
